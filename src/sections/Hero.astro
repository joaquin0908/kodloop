<!-- Hero — full-viewport with animated SVG background, parallax, live clock -->
<section class="kl-hero" data-screen-label="01 Hero">
  <!-- Animated SVG background -->
  <svg class="kl-hero__bg" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <pattern id="kl-grid" width="80" height="80" patternUnits="userSpaceOnUse">
        <path d="M 80 0 L 0 0 0 80" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.15"/>
      </pattern>
    </defs>
    <rect width="1600" height="900" fill="url(#kl-grid)"/>
    <!-- Large rotating ring -->
    <g class="kl-hero__bg-ring" style="transform-origin: 1300px 250px">
      <circle cx="1300" cy="250" r="200" fill="none" stroke="currentColor" stroke-width="1" opacity="0.25" stroke-dasharray="4 8"/>
      <circle cx="1300" cy="250" r="140" fill="none" stroke="currentColor" stroke-width="1" opacity="0.4"/>
      <circle cx="1300" cy="250" r="80" fill="none" stroke="currentColor" stroke-width="1" opacity="0.6" stroke-dasharray="20 6"/>
    </g>
    <!-- Counter-rotating ring -->
    <g class="kl-hero__bg-ring kl-hero__bg-ring--rev" style="transform-origin: 200px 700px">
      <circle cx="200" cy="700" r="120" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3" stroke-dasharray="2 4"/>
      <circle cx="200" cy="700" r="60" fill="none" stroke="currentColor" stroke-width="1" opacity="0.5"/>
      <line x1="80" y1="700" x2="320" y2="700" stroke="currentColor" stroke-width="0.5" opacity="0.4"/>
      <line x1="200" y1="580" x2="200" y2="820" stroke="currentColor" stroke-width="0.5" opacity="0.4"/>
    </g>
    <!-- Floating brackets -->
    <text class="kl-hero__bg-bracket kl-hero__bg-bracket--a" x="100" y="200" font-family="monospace" font-size="80" fill="currentColor" opacity="0.12">{`{`}</text>
    <text class="kl-hero__bg-bracket kl-hero__bg-bracket--b" x="1450" y="800" font-family="monospace" font-size="80" fill="currentColor" opacity="0.12">{`}`}</text>
    <!-- Dashed loop curve -->
    <path class="kl-hero__bg-loop" d="M 0 450 Q 400 350 800 450 T 1600 450" fill="none" stroke="currentColor" stroke-width="1" opacity="0.35" stroke-dasharray="6 10"/>
    <!-- Scattered dots -->
    <g class="kl-hero__bg-dots">
      <circle cx="450" cy="150" r="3" fill="currentColor" opacity="0.4"/>
      <circle cx="900" cy="700" r="2" fill="currentColor" opacity="0.5"/>
      <circle cx="1100" cy="120" r="4" fill="currentColor" opacity="0.3"/>
      <circle cx="600" cy="780" r="2" fill="currentColor" opacity="0.4"/>
      <circle cx="350" cy="500" r="2" fill="currentColor" opacity="0.5"/>
    </g>
  </svg>

  <div class="kl-hero__type" id="hero-type">
    <h1 class="kl-display">
      <span class="kl-display__row">
        <span class="kl-display__word">CICLOS</span>
        <span class="kl-display__bracket">{`{`}</span>
      </span>
      <span class="kl-display__row kl-display__row--offset">
        <span class="kl-display__word kl-display__word--outline">SEGUROS</span>
      </span>
      <span class="kl-display__row kl-display__row--end">
        <span class="flex items-center gap-4">
          <span class="kl-display__bracket">{`}`}</span>
          <span class="kl-display__word" style="font-size: 0.85em; background-color: #A52545">CODIGO EXACTO</span>
        </span>
      </span>
    </h1>
  </div>

</section>
