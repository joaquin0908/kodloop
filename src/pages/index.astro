---
import Layout from '../layouts/Layout.astro';
import Loader from '../components/Loader.astro';
import Navbar from '../components/Navbar.astro';
import Marquee from '../components/Marquee.astro';
import Hero from '../sections/Hero.astro';
import Nosotros from '../sections/Nosotros.astro';
import Servicios from '../sections/Servicios.astro';
import Proyectos from '../sections/Proyectos.astro';
import Contacto from '../sections/Contacto.astro';
---

<Layout>
  <Loader />
  <Navbar />
  <main>
    <Hero />
<Marquee
      items={['Código Limpio', 'Comunicacion Continua', 'Sistemas Robustos', 'Soluciones Ágiles']}
      speed={40}
    />
    <Nosotros />
    <Servicios />
    <Marquee
      items={['EN PRODUCCIÓN', 'PROYECTOS REALES', 'KODLOOP', 'RESULTADOS EXACTOS','CLIENTES SATISFECHOS']}
      speed={48}
      reverse
    />
    <Proyectos />
    <Contacto />
  </main>
</Layout>
